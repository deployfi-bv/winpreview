# OCR models — tracked in git (*.bin + dict.txt, ~18MB total)

# ONNX Runtime WASM binaries (copied from node_modules, ~37MB)
public/*.wasm
public/*.mjs
# But keep the JSEP worker — required at runtime for OCR
!public/ort-wasm-simd-threaded.jsep.mjs
